Optimized code:

public class Main {
    public static void main(String args[]) {
        String s1 = "nagpur is in maharashtra";
        if (s1.isEmpty()) {
            System.out.println("String is empty");
        } else {
            String[] words = s1.trim().split("\\s+"); // Split into words
            StringBuilder reversed = new StringBuilder();
            for (int i = words.length - 1; i >= 0; i--) { // Traverse in reverse
                reversed.append(words[i]).append(" ");
            }
            System.out.println(reversed.toString().trim()); // Remove trailing space
        }
    }
}
